// Nest's application Worker: same-origin /api/*, SSE and the scheduled handler.
// D1 resources come from infra/cloudflare/d1-resources.json. The default environment binds
// mainnet; `--env testnet` binds the Testnet database. Financial writes stay disabled.
// A one-minute cron wakes the automation dispatcher (src/automations/dispatch.ts); due rules,
// jobs and leases live in D1, so the cron is only a wake-up signal.
// Each agent conversation is a SQLite-backed Durable Object (src/agent/conversation.ts).
// PI_MODEL_ID must be a free OpenRouter model; src/agent/models.ts refuses anything else.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nest",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  // pi-mcp's OAuth flow (PKCE, state) uses Node's Buffer; nothing else needs Node APIs.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "preview_urls": false,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "STELLAR_NETWORK": "mainnet",
    "EXECUTION_ENABLED": "false",
    "PI_PROVIDER": "openrouter",
    "PI_MODEL_ID": "thinkingmachines/inkling:free",
    "AGENT_GUEST_TURNS_PER_15_MIN": "5",
    "AGENT_MAX_ACTIVE_RUNS": "4",
    "ENABLED_WRITE_ADAPTERS": "",
    "STELLAR_TESTNET_RPC_URL": "https://soroban-testnet.stellar.org"
  },
  // Provider RPC URLs often embed an API key, so the mainnet URL is a secret. Only declared names
  // are read from .dev.vars.
  "secrets": {
    "required": [
      "OPENROUTER_API_KEY",
      "APP_ENCRYPTION_KEY",
      "SOROSWAP_API_KEY",
      "DEFINDEX_API_KEY",
      "STELLAR_MAINNET_RPC_URL",
      "RAVEN_OPERATOR_KEY"
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "CONVERSATIONS", "class_name": "ConversationAgent" },
      { "name": "RAVEN", "class_name": "RavenConnection" },
      { "name": "ADMISSION", "class_name": "AgentAdmission" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ConversationAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["RavenConnection"] },
    { "tag": "v3", "new_sqlite_classes": ["AgentAdmission"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nest-mainnet",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "env": {
    "testnet": {
      "preview_urls": false,
      "vars": {
        "STELLAR_NETWORK": "testnet",
        "EXECUTION_ENABLED": "false",
        "PI_PROVIDER": "openrouter",
        "PI_MODEL_ID": "thinkingmachines/inkling:free",
        "AGENT_GUEST_TURNS_PER_15_MIN": "5",
        "AGENT_MAX_ACTIVE_RUNS": "4",
        "ENABLED_WRITE_ADAPTERS": "",
        "STELLAR_TESTNET_RPC_URL": "https://soroban-testnet.stellar.org"
      },
      "secrets": {
        "required": [
          "OPENROUTER_API_KEY",
          "APP_ENCRYPTION_KEY",
          "SOROSWAP_API_KEY",
          "DEFINDEX_API_KEY",
          "RAVEN_OPERATOR_KEY"
        ]
      },
      "durable_objects": {
        "bindings": [
          { "name": "CONVERSATIONS", "class_name": "ConversationAgent" },
          { "name": "RAVEN", "class_name": "RavenConnection" },
          { "name": "ADMISSION", "class_name": "AgentAdmission" }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nest-testnet",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "migrations",
          "remote": false
        }
      ]
    }
  }
}
