{
  "name": "@nest/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "types": "wrangler types",
    "types:check": "wrangler types --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:testnet": "wrangler d1 migrations apply DB --remote --env testnet"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-mcp": "catalog:",
    "@nest/adapters": "workspace:*",
    "@nest/agent-runtime": "workspace:*",
    "@nest/data": "workspace:*",
    "@nest/domain": "workspace:*",
    "@nest/policy": "workspace:*",
    "@stellar/stellar-sdk": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "typebox": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
